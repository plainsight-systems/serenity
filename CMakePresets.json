{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_OBJC_COMPILER": "/usr/bin/clang",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0",
        "CMAKE_OSX_SYSROOT": "macosx",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "native-debug",
      "displayName": "Native debug (tests)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/native-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "native-release",
      "displayName": "Native release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/native-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "native-sanitize",
      "displayName": "Native debug under UndefinedBehaviorSanitizer (tests)",
      "description": "UBSan only: AddressSanitizer's runtime hangs initializing on macOS 26.6.2, docs/research/2026-10-10-sanitizers.md",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/native-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=all -fsanitize-ignorelist=${sourceDir}/cmake/ubsan_ignorelist.txt -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=all -fsanitize-ignorelist=${sourceDir}/cmake/ubsan_ignorelist.txt -fno-omit-frame-pointer",
        "CMAKE_OBJC_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=all -fsanitize-ignorelist=${sourceDir}/cmake/ubsan_ignorelist.txt -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug"
    },
    {
      "name": "native-release",
      "configurePreset": "native-release"
    },
    {
      "name": "native-sanitize",
      "configurePreset": "native-sanitize"
    }
  ],
  "testPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-release",
      "configurePreset": "native-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-sanitize",
      "configurePreset": "native-sanitize",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    }
  ]
}
