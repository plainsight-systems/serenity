            tensor<fp16, [8, 24, 3, 3]> unet_dec_3_weight_to_fp16 = const()[name = string("unet_dec_3_weight_to_fp16"), val = tensor<fp16, [8, 24, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(158208)))];
            tensor<fp16, [8]> unet_dec_3_bias_to_fp16 = const()[name = string("unet_dec_3_bias_to_fp16"), val = tensor<fp16, [8]>([-0x1.58p-6, 0x1.e54p-5, 0x1.fc4p-5, 0x1.fcp-6, 0x1.108p-7, 0x1.8c4p-5, -0x1.73cp-5, 0x1.928p-8])];
            tensor<fp16, [1, 8, ?, ?]> input_53_cast_fp16 = conv(bias = unet_dec_3_bias_to_fp16, dilations = input_53_dilations_0, groups = input_53_groups_0, pad = input_53_pad_0, pad_type = input_53_pad_type_0, strides = input_53_strides_0, weight = unet_dec_3_weight_to_fp16, x = input_51_cast_fp16)[name = string("input_53_cast_fp16")];
            tensor<fp16, [1, 8, ?, ?]> input_55_cast_fp16 = relu(x = input_53_cast_fp16)[name = string("input_55_cast_fp16")];
            string input_pad_type_0 = const()[name = string("input_pad_type_0"), val = string("custom")];
            tensor<int32, [4]> input_pad_0 = const()[name = string("input_pad_0"), val = tensor<int32, [4]>([1, 1, 1, 1])];
